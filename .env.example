# Google Gemini API Key
# Dapatkan API key gratis di https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=

# EmailJS Configuration (Opsional - untuk kirim OTP real ke Gmail)
# Daftar akun gratis di https://www.emailjs.com/
# Buat Email Service (Gmail) dan Template dengan variabel: {{to_name}}, {{to_email}}, {{otp_code}}
# Jika dibiarkan kosong, aplikasi otomatis beralih ke mode simulasi (kode OTP langsung tampil di layar)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_RESET_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

